    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "jose": "^6.2.9",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
